<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Certificate pinning is NOT enabled yet: it needs the real server
     domain + SPKI hashes (incl. a backup pin). See NEXT_STEPS.md. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
